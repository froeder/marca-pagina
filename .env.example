# Configurações do Firebase
# Obtenha estas credenciais no Firebase Console (https://console.firebase.google.com/):
# 1. Acesse o console e crie/selecione um projeto
# 2. Em 'Visão geral do projeto' > 'Configurações do projeto' (ícone de engrenagem)
# 3. Na seção 'Seus aplicativos', adicione um app Web (ícone </>)
# 4. Copie os valores do objeto firebaseConfig para as variáveis abaixo:

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_DATABASE_ID=marca-paginas
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_messaging_sender_id
VITE_FIREBASE_APP_ID=seu_app_id
VITE_FIREBASE_MEASUREMENT_ID=seu_measurement_id

# Chave opcional da Google Books API (caso queira aumentar a cota de buscas)
VITE_GOOGLE_BOOKS_API_KEY=
