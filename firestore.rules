rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para usuários autenticados no Marca-Página
    match /users/{userId} {
      // O usuário pode ler e gravar seu próprio perfil e metas
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // O usuário pode ler e gravar sua própria estante de livros
      match /books/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
